diff --git a/internal/qmi/client_options_test.go b/internal/qmi/client_options_test.go
index b087e65..6971c21 100644
--- a/internal/qmi/client_options_test.go
+++ b/internal/qmi/client_options_test.go
@@ -9,6 +9,20 @@ import (
 	"github.com/iniwex5/vohive/internal/config"
 )
 
+func TestPlatformDefaultQMIProxyExecutableExists(t *testing.T) {
+	opts := platformDefaultClientOptions()
+	if opts.ProxyExecutable == "" {
+		t.Fatal("ProxyExecutable is empty")
+	}
+	info, err := os.Stat(opts.ProxyExecutable)
+	if err != nil {
+		t.Fatalf("stat ProxyExecutable %q: %v", opts.ProxyExecutable, err)
+	}
+	if info.Mode()&0o111 == 0 {
+		t.Fatalf("ProxyExecutable %q is not executable", opts.ProxyExecutable)
+	}
+}
