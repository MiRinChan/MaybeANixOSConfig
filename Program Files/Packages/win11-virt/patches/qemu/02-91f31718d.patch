From 91f31718ddcd8acea83f2a158b75a61a48062e15 Mon Sep 17 00:00:00 2001
From: Ake Rehnman <ake.rehnman@gmail.com>
Date: Tue, 25 Aug 2026 21:28:23 +0200
Subject: [PATCH] ui/spice: Fix mailbox scanout orientation

Mailbox scanouts are always exported to SPICE with y_0_top set to
false. The snapshot path applied the vertical transform for the opposite
source orientation, causing top-origin scanouts to appear upside down.

Flip top-origin sources while copying them into the mailbox and identify
ordinary display surfaces as bottom-origin.

Fixes: cf3bba5c26df ("ui: decouple GL presentation from renderer blocking")
Signed-off-by: Ake Rehnman <ake.rehnman@gmail.com>
---
 ui/spice-display.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/ui/spice-display.c b/ui/spice-display.c
index dc31481bc99..ef81f162c60 100644
--- a/ui/spice-display.c
+++ b/ui/spice-display.c
@@ -1208,8 +1208,9 @@ static void spice_gl_snapshot(SimpleSpiceDisplay *ssd, egl_fb *src,
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dst->framebuffer);
     glViewport(0, 0, width, height);
     glClear(GL_COLOR_BUFFER_BIT);
-    y1 = y_0_top ? src_y : src_y + height;
-    y2 = y_0_top ? src_y + height : src_y;
+    /* Mailbox scanouts are exported with y_0_top set to false. */
+    y1 = y_0_top ? src_y + height : src_y;
+    y2 = y_0_top ? src_y : src_y + height;
     glBlitFramebuffer(src_x, y1, src_x + width, y2,
                       0, 0, width, height,
                       GL_COLOR_BUFFER_BIT, GL_LINEAR);
@@ -1254,7 +1255,7 @@ static void spice_gl_snapshot_surface(SimpleSpiceDisplay *ssd)
     egl_fb_setup_for_tex(&src, surface_width(ssd->ds),
                          surface_height(ssd->ds), ssd->ds->texture, false);
     spice_gl_snapshot(ssd, &src, 0, 0, src.width, src.height,
-                      true, NULL);
+                      false, NULL);
     egl_fb_destroy(&src);
     ssd->gl_updates = 0;
 }
