 include/ui/egl-helpers.h |   2 +-
 ui/dbus-listener.c       |   4 +-
 ui/dmabuf.c              |  14 ++++++
 ui/egl-headless.c        |   8 ++-
 ui/egl-helpers.c         | 102 +++++++++++++++++++++++++++++++++++----
 ui/gtk-egl.c             |   8 ++-
 ui/gtk-gl-area.c         |   4 +-
 ui/sdl2-gl.c             |   3 +-
 ui/spice-display.c       |   8 ++-
 10 files changed, 135 insertions(+), 20 deletions(-)

