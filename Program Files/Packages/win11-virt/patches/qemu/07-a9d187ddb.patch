index 1547ad2f6f8..670b9fef0c0 100644
--- a/ui/sdl2-gl.c
+++ b/ui/sdl2-gl.c
@@ -263,8 +263,7 @@ void sdl2_gl_scanout_dmabuf(DisplayChangeListener *dcl,
     assert(scon->opengl);
     SDL_GL_MakeCurrent(scon->real_window, scon->winctx);
 
