             surface_gl_destroy_texture(vc->gfx.gls, vc->gfx.ds);
             qemu_gl_fini_shader(vc->gfx.gls);
         }
+        if (vc->gfx.mailbox_copy_pending) {
+            QemuDmaBuf *dmabuf = vc->gfx.mailbox_dmabuf;
