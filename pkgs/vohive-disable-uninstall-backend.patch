+func TestHandleUninstallIsDisabledForAuthenticatedRequest(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	s := &Server{auth: config.WebConfig{Username: "admin", Password: "secret"}}
+	token, _, err := s.issueSessionToken()
+	if err != nil {
+		t.Fatalf("issueSessionToken: %v", err)
+	}
+
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(http.MethodPost, "/api/system/uninstall", nil)
+	c.Request.Header.Set("Authorization", "Bearer "+token)
+
+	s.handleUninstall(c)
+
+	if w.Code != http.StatusForbidden {
+		t.Fatalf("code=%d body=%s, want 403", w.Code, w.Body.String())
+	}
+	if !strings.Contains(w.Body.String(), "uninstall_disabled") {
+		t.Fatalf("body=%s, want uninstall_disabled", w.Body.String())
+	}
+}
