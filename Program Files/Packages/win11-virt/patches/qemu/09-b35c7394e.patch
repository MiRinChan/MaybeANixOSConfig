From b35c7394e8d8a243e732b30d3a808278ee808ac6 Mon Sep 17 00:00:00 2001
From: Ake Rehnman <ake.rehnman@gmail.com>
Date: Tue, 13 Oct 2026 21:03:58 +0200
Subject: [PATCH] virtio-gpu: mark udmabuf framebuffers as linear

The udmabuf framebuffer path uses linear strides. Advertise
DRM_FORMAT_MOD_LINEAR rather than the implementation-defined INVALID
modifier so EGL can query the correct texture import requirements.
---
 hw/display/virtio-gpu-udmabuf.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hw/display/virtio-gpu-udmabuf.c b/hw/display/virtio-gpu-udmabuf.c
index 5f08c855dde..ebcf210ded2 100644
--- a/hw/display/virtio-gpu-udmabuf.c
+++ b/hw/display/virtio-gpu-udmabuf.c
@@ -202,7 +202,8 @@ static VGPUDMABuf
                                   &offset, &fb->stride,
                                   r->x, r->y, fb->width, fb->height,
                                   qemu_pixman_to_drm_format(fb->format),
-                                  DRM_FORMAT_MOD_INVALID, &res->dmabuf_fd,
+                                  /* This framebuffer path uses linear strides. */
+                                  DRM_FORMAT_MOD_LINEAR, &res->dmabuf_fd,
                                   1, true, false);
     dmabuf->scanout_id = scanout_id;
     QTAILQ_INSERT_HEAD(&g->dmabuf.bufs, dmabuf, next);
