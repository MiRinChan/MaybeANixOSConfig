From 2849a68154ff058e50bcca89b27dcd1f59591311 Mon Sep 17 00:00:00 2001
From: Ake Rehnman <ake.rehnman@gmail.com>
Date: Tue, 13 Oct 2026 21:04:01 +0200
Subject: [PATCH] ui/gtk: sample external-only DMA-BUF scanouts

NVIDIA exposes LINEAR DMA-BUFs as external-only EGL imports. Enable
external imports in both GTK GL backends and sample them into the
private mailbox instead of attaching them to a framebuffer.

Preserve producer synchronization and source lifetime, invalidate failed
copies, and clear stale scanout state when switching display modes.
---
 ui/gtk-egl.c     | 43 +++++++++++++++++++++++++++++++++++++++----
 ui/gtk-gl-area.c | 40 +++++++++++++++++++++++++++++++++++-----
 ui/gtk.c         | 15 ++++++++++++---
 3 files changed, 86 insertions(+), 12 deletions(-)

diff --git a/ui/gtk-egl.c b/ui/gtk-egl.c
index d9da2a80caa..3475ec7ed7b 100644
--- a/ui/gtk-egl.c
+++ b/ui/gtk-egl.c
@@ -35,6 +35,8 @@ static void gtk_egl_set_scanout_mode(VirtualConsole *vc, bool scanout)
         eglMakeCurrent(qemu_egl_display, vc->gfx.esurface,
                        vc->gfx.esurface, vc->gfx.ectx);
         egl_fb_destroy(&vc->gfx.guest_fb);
+        vc->gfx.guest_fb.dmabuf = NULL;
+        vc->gfx.guest_fb.texture = 0;
         egl_fb_destroy(&vc->gfx.mailbox_fb);
         vc->gfx.mailbox_valid = false;
         if (vc->gfx.surface) {
@@ -232,6 +234,7 @@ void gd_egl_scanout_texture(DisplayChangeListener *dcl,
                    vc->gfx.esurface, vc->gfx.ectx);
 
     gtk_egl_set_scanout_mode(vc, true);
+    vc->gfx.guest_fb.dmabuf = NULL;
     egl_fb_destroy(&vc->gfx.mailbox_fb);
     vc->gfx.mailbox_valid = false;
     egl_fb_setup_for_tex(&vc->gfx.guest_fb, backing_width, backing_height,
@@ -246,10 +249,17 @@ void gd_egl_scanout_dmabuf(DisplayChangeListener *dcl,
     uint32_t x, y, width, height, backing_width, backing_height, texture;
     bool y0_top;
 
+    if (!vc->gfx.esurface) {
+        gd_egl_init(vc);
+        if (!vc->gfx.esurface) {
+            return;
+        }
+    }
     eglMakeCurrent(qemu_egl_display, vc->gfx.esurface,
                    vc->gfx.esurface, vc->gfx.ectx);
 
-    if (!egl_dmabuf_import_texture(dmabuf, false)) {
+    if (!egl_dmabuf_import_texture(dmabuf, true)) {
+        gtk_egl_set_scanout_mode(vc, false);
         return;
     }
     texture = qemu_dmabuf_get_texture(dmabuf);
@@ -265,8 +275,33 @@ void gd_egl_scanout_dmabuf(DisplayChangeListener *dcl,
     backing_height = qemu_dmabuf_get_backing_height(dmabuf);
     y0_top = qemu_dmabuf_get_y0_top(dmabuf);
 
-    gd_egl_scanout_texture(dcl, texture, y0_top, backing_width, backing_height,
-                           x, y, width, height, NULL);
+    if (qemu_dmabuf_get_texture_target(dmabuf) == GL_TEXTURE_EXTERNAL_OES) {
+        if (!qemu_dmabuf_get_allow_fences(dmabuf)) {
+            error_report("gtk: external DMA-BUF scanout requires producer "
+                         "fences for the GPU mailbox copy");
+            gtk_egl_set_scanout_mode(vc, false);
+            return;
+        }
+        if (!vc->gfx.gls) {
+            vc->gfx.gls = qemu_gl_init_shader();
+        }
+        vc->gfx.x = x;
+        vc->gfx.y = y;
+        vc->gfx.w = width;
+        vc->gfx.h = height;
+        vc->gfx.y0_top = y0_top;
+        gtk_egl_set_scanout_mode(vc, true);
+        egl_fb_destroy(&vc->gfx.guest_fb);
+        egl_fb_destroy(&vc->gfx.mailbox_fb);
+        vc->gfx.mailbox_valid = false;
+        /* External textures may be sampled, never attached to a framebuffer. */
+        vc->gfx.guest_fb.width = backing_width;
+        vc->gfx.guest_fb.height = backing_height;
+        vc->gfx.guest_fb.texture = texture;
+    } else {
+        gd_egl_scanout_texture(dcl, texture, y0_top, backing_width, backing_height,
+                               x, y, width, height, NULL);
+    }
 
     if (qemu_dmabuf_get_allow_fences(dmabuf)) {
         vc->gfx.guest_fb.dmabuf = dmabuf;
@@ -325,7 +360,7 @@ void gd_egl_scanout_flush(DisplayChangeListener *dcl,
     if (!vc->gfx.scanout_mode) {
         return;
     }
-    if (!vc->gfx.guest_fb.framebuffer) {
+    if (!vc->gfx.guest_fb.framebuffer && !vc->gfx.guest_fb.dmabuf) {
         return;
     }
     if (vc->gfx.guest_fb.dmabuf) {
diff --git a/ui/gtk-gl-area.c b/ui/gtk-gl-area.c
index d7bb9bcc42f..be3980aa808 100644
--- a/ui/gtk-gl-area.c
+++ b/ui/gtk-gl-area.c
@@ -9,6 +9,7 @@
 
 #include "qemu/osdep.h"
 #include "qemu/main-loop.h"
+#include "qemu/error-report.h"
 
 #include "trace.h"
 
@@ -28,6 +29,8 @@ static void gtk_gl_area_set_scanout_mode(VirtualConsole *vc, bool scanout)
     if (!vc->gfx.scanout_mode) {
         gtk_gl_area_make_current(GTK_GL_AREA(vc->gfx.drawing_area));
         egl_fb_destroy(&vc->gfx.guest_fb);
+        vc->gfx.guest_fb.dmabuf = NULL;
+        vc->gfx.guest_fb.texture = 0;
         egl_fb_destroy(&vc->gfx.mailbox_fb);
         vc->gfx.mailbox_valid = false;
         if (vc->gfx.surface) {
@@ -75,7 +78,7 @@ void gd_gl_area_draw(VirtualConsole *vc)
     }
 
     if (vc->gfx.scanout_mode) {
-        if (!vc->gfx.guest_fb.framebuffer) {
+        if (!vc->gfx.guest_fb.framebuffer && !vc->gfx.guest_fb.dmabuf) {
             return;
         }
 
@@ -288,6 +291,7 @@ void gd_gl_area_scanout_texture(DisplayChangeListener *dcl,
     }
 
     gtk_gl_area_set_scanout_mode(vc, true);
+    vc->gfx.guest_fb.dmabuf = NULL;
     egl_fb_destroy(&vc->gfx.mailbox_fb);
     vc->gfx.mailbox_valid = false;
     egl_fb_setup_for_tex(&vc->gfx.guest_fb, backing_width, backing_height,
@@ -323,7 +327,8 @@ void gd_gl_area_scanout_dmabuf(DisplayChangeListener *dcl,
     bool y0_top;
 
     gtk_gl_area_make_current(GTK_GL_AREA(vc->gfx.drawing_area));
-    if (!egl_dmabuf_import_texture(dmabuf, false)) {
+    if (!egl_dmabuf_import_texture(dmabuf, true)) {
+        gtk_gl_area_set_scanout_mode(vc, false);
         return;
     }
     texture = qemu_dmabuf_get_texture(dmabuf);
@@ -339,9 +344,34 @@ void gd_gl_area_scanout_dmabuf(DisplayChangeListener *dcl,
     backing_height = qemu_dmabuf_get_backing_height(dmabuf);
     y0_top = qemu_dmabuf_get_y0_top(dmabuf);
 
-    gd_gl_area_scanout_texture(dcl, texture, y0_top,
-                               backing_width, backing_height,
-                               x, y, width, height, NULL);
+    if (qemu_dmabuf_get_texture_target(dmabuf) == GL_TEXTURE_EXTERNAL_OES) {
+        if (!qemu_dmabuf_get_allow_fences(dmabuf)) {
+            error_report("gtk: external DMA-BUF scanout requires producer "
+                         "fences for the GPU mailbox copy");
+            gtk_gl_area_set_scanout_mode(vc, false);
+            return;
+        }
+        if (!vc->gfx.gls) {
+            vc->gfx.gls = qemu_gl_init_shader();
+        }
+        vc->gfx.x = x;
+        vc->gfx.y = y;
+        vc->gfx.w = width;
+        vc->gfx.h = height;
+        vc->gfx.y0_top = y0_top;
+        gtk_gl_area_set_scanout_mode(vc, true);
+        egl_fb_destroy(&vc->gfx.guest_fb);
+        egl_fb_destroy(&vc->gfx.mailbox_fb);
+        vc->gfx.mailbox_valid = false;
+        /* External textures may be sampled, never attached to a framebuffer. */
+        vc->gfx.guest_fb.width = backing_width;
+        vc->gfx.guest_fb.height = backing_height;
+        vc->gfx.guest_fb.texture = texture;
+    } else {
+        gd_gl_area_scanout_texture(dcl, texture, y0_top,
+                                   backing_width, backing_height,
+                                   x, y, width, height, NULL);
+    }
 
     if (qemu_dmabuf_get_allow_fences(dmabuf)) {
         vc->gfx.guest_fb.dmabuf = dmabuf;
diff --git a/ui/gtk.c b/ui/gtk.c
index 0ca9704d6fa..eadfa899e94 100644
--- a/ui/gtk.c
+++ b/ui/gtk.c
@@ -603,6 +603,7 @@ bool gd_gl_mailbox_update(VirtualConsole *vc)
     QemuDmaBuf *dmabuf = vc->gfx.guest_fb.dmabuf;
     int fence_fd;
     int width, height;
+    bool copied = true;
 
     if (!dmabuf) {
         return false;
@@ -620,14 +621,19 @@ bool gd_gl_mailbox_update(VirtualConsole *vc)
     }
 
     /* Preserve orientation; the draw path applies y0_top. */
-    egl_fb_blit(&vc->gfx.mailbox_fb, &vc->gfx.guest_fb, false);
+    if (qemu_dmabuf_get_texture_target(dmabuf) == GL_TEXTURE_EXTERNAL_OES) {
+        copied = egl_external_texture_blit(vc->gfx.gls, &vc->gfx.mailbox_fb,
+                                           dmabuf, false);
+    } else {
+        egl_fb_blit(&vc->gfx.mailbox_fb, &vc->gfx.guest_fb, false);
+    }
     egl_dmabuf_create_sync(dmabuf);
 
     /* Hold the producer only until the private copy consumed the source. */
     qemu_console_hw_gl_block(vc->gfx.dcl.con, true);
     vc->gfx.mailbox_copy_pending = true;
     vc->gfx.mailbox_dmabuf = dmabuf;
-    vc->gfx.mailbox_valid = true;
+    vc->gfx.mailbox_valid = copied;
     glFlush();
     egl_dmabuf_create_fence(dmabuf);
     fence_fd = qemu_dmabuf_get_fence_fd(dmabuf);
@@ -635,12 +641,15 @@ bool gd_gl_mailbox_update(VirtualConsole *vc)
         qemu_set_fd_handler(fence_fd, gd_hw_gl_flushed, NULL, vc);
     } else {
         /* A synchronous fallback is required for producer ordering. */
+        warn_report("gtk: GPU mailbox synchronization uses the synchronous "
+                    "glFinish fallback because no native producer-release "
+                    "fence FD was created");
         glFinish();
         vc->gfx.mailbox_copy_pending = false;
         vc->gfx.mailbox_dmabuf = NULL;
         qemu_console_hw_gl_block(vc->gfx.dcl.con, false);
     }
-    return true;
+    return copied;
 #else
     return false;
 #endif
